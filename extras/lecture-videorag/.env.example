# Copy to .env. Never commit .env.
# openai | anthropic | fake  (fake = offline canned answers, for tests/demo without a key)
LVR_LLM_PROVIDER=openai

# OpenAI-compatible provider (default). Works with OpenAI directly or with OpenRouter.
# OpenRouter: key sk-or-..., base URL below, model ids with vendor prefix (openai/gpt-4o-mini).
# OpenAI direct: remove LVR_OPENAI_BASE_URL and use plain model ids (gpt-4o-mini).
OPENAI_API_KEY=
LVR_OPENAI_BASE_URL=https://openrouter.ai/api/v1
LVR_OPENAI_MODEL=openai/gpt-4o-mini

# Claude (only when LVR_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LVR_LLM_MODEL=claude-opus-5-5
# Server-side refusal fallbacks for Claude (beta). Set false to disable.
LVR_LLM_FALLBACKS=true
# Effort per task: low | medium | high | xhigh | max
LVR_EFFORT_FRAMES=low
LVR_EFFORT_NOTES=high
LVR_EFFORT_CHAT=medium

# sentence-transformers | hash  (hash = tiny offline embedder for tests)
LVR_EMBEDDING_PROVIDER=sentence-transformers
LVR_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# After the first run has downloaded the model, stop checking Hugging Face on every start:
# HF_HUB_OFFLINE=1

# Language of generated notes and answers: vi | en | auto (= language of the question/lecture)
LVR_OUTPUT_LANGUAGE=vi

# Transcript source: auto (YouTube subtitles, else Whisper) | whisper (always speech-to-text,
# the LMS path for videos without subtitles) | subtitles (YouTube subtitles only)
LVR_TRANSCRIPT_MODE=whisper
# Whisper model: large-v3-turbo (GPU, ~12x real time on 4 GB) | small (CPU-only machines)
LVR_WHISPER_MODEL=large-v3-turbo
# Lecture language for Whisper: empty = auto-detect, or vi / en
LVR_WHISPER_LANGUAGE=

# Visual pipeline
LVR_DESCRIBE_FRAMES=true
LVR_MAX_FRAMES_PER_VIDEO=60
LVR_VIDEO_MAX_HEIGHT=720

# LMS video files (upload / direct link): size limit per file, stored in <data dir>/videos
LVR_MAX_UPLOAD_MB=4096
